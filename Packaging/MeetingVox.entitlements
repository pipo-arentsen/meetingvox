<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not sandboxed and no hardened runtime (see Packaging/README.md): the app reads
  ~/.config, writes ~/Recordings and talks to a LAN server. audio-input is
  declared so the microphone grant survives if hardened runtime is ever enabled,
  and so is personal-information.calendars for the opt-in calendar link (read-only).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
